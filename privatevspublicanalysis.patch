+def build_jurisdiction_chart(df: pd.DataFrame) -> ChartArtifact:
+    agg = (
+        df.groupby(["country_code", "entity_type"])
+        .agg(cases=("decision_id", "count"), total_fine=("fine_eur", "sum"))
+        .reset_index()
+    )
+    top_public_countries = (
+        agg[agg["entity_type"] == "Public sector body"].sort_values("cases", ascending=False).head(6)["country_code"]
+    )
+    plot_df = agg[agg["country_code"].isin(top_public_countries)].copy()
+    fig, ax = plt.subplots(figsize=(10, 6))
+    sns.barplot(data=plot_df, x="country_code", y="cases", hue="entity_type", ax=ax)
+    ax.set_title("Jurisdictional focus of public-sector enforcement")
+    ax.set_xlabel("Country code (Q1)")
+    ax.set_ylabel("Number of decisions")
+    ax.legend(title="Entity type")
+    artifact = save_chart(fig, "jurisdiction_focus.png")
+    artifact.description = (
+        "Six most active jurisdictions for public bodies also show contrasting private-enforcement footprints."
+    )
+    return artifact
