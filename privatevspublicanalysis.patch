+def render_report(df: pd.DataFrame, charts: List[ChartArtifact], context: Dict[str, str]) -> None:
+    html_sections = []
+    md_sections = []
+    for chart in charts:
+        if chart.path.exists():
+            data_uri = encode_image(chart.path)
+            html_sections.append(
+                f"<figure><img src='{data_uri}' alt='{chart.title}'/><figcaption>{chart.description}</figcaption></figure>"
+            )
+            md_sections.append(chart.as_markdown())
