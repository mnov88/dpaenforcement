+def compute_multiselect_summary(
+    df: pd.DataFrame, prefix: str, options: Iterable[str]
+) -> pd.DataFrame:
+    records = []
+    for entity, group in df.groupby("entity_type"):
+        total = len(group)
+        if total == 0:
+            continue
+        for opt in options:
+            col = f"{prefix}_{opt}"
+            if col not in group.columns:
+                continue
+            value = group[col].fillna(0).sum()
+            share = value / total
+            records.append(
+                {
+                    "entity_type": entity,
+                    "option": opt,
+                    "count": float(value),
+                    "share": share,
+                }
+            )
+    return pd.DataFrame.from_records(records)
+
+
+def lookup_share(summary_df: pd.DataFrame, entity: str, option: str) -> float:
+    mask = (summary_df["entity_type"] == entity) & (summary_df["option"] == option)
+    if mask.any():
+        return float(summary_df.loc[mask, "share"].iloc[0])
+    return 0.0
+
