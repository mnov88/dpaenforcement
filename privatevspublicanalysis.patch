+def load_data() -> pd.DataFrame:
+    if not DATA_PATH.exists():
+        raise FileNotFoundError(f"Expected cleaned dataset at {DATA_PATH}")
+    df = pd.read_csv(DATA_PATH)
+    for new_col, raw_col in ENUM_QUESTIONS.items():
+        if raw_col in df.columns:
+            df[new_col] = (
+                df[raw_col]
+                .fillna("UNSPECIFIED")
+                .astype(str)
+                .str.replace("TYPE:", "", regex=False)
+                .str.replace("ENUM:", "", regex=False)
+            )
+        else:
+            df[new_col] = "UNAVAILABLE"
+    return df
+
+
+def classify_entity(row: pd.Series) -> str:
+    if row.get("q10_org_class_PUBLIC_SECTOR_BODY", 0) == 1:
+        return "Public sector body"
+    status = str(row.get("raw_q8", "UNSPECIFIED"))
+    status_upper = status.upper()
+    if status_upper == "NATURAL_PERSON":
+        return "Natural person"
+    if status_upper == "ORGANIZATION":
+        private_flags = [
+            row.get("q10_org_class_SME", 0),
+            row.get("q10_org_class_LARGE_ENTERPRISE", 0),
+            row.get("q10_org_class_MULTINATIONAL", 0),
+            row.get("q10_org_class_NON_PROFIT", 0),
+        ]
+        if any(flag == 1 for flag in private_flags):
+            return "Private organization"
+        if row.get("q10_org_class_PUBLIC_SECTOR_BODY", 0) == 1:
+            return "Public sector body"
+        if row.get("q10_org_class_NOT_APPLICABLE", 0) == 1:
+            return "Private organization"
+        if row.get("q10_org_class_NOT_MENTIONED", 0) == 1:
+            return "Private organization"
+        return "Private organization"
+    if "PUBLIC_SECTOR_BODY" in status_upper:
+        return "Public sector body"
+    if status_upper in {"NOT_MENTIONED", "UNCLEAR", "UNSPECIFIED"}:
+        private_flags = [
+            row.get("q10_org_class_SME", 0),
+            row.get("q10_org_class_LARGE_ENTERPRISE", 0),
+            row.get("q10_org_class_MULTINATIONAL", 0),
+            row.get("q10_org_class_NON_PROFIT", 0),
+        ]
+        if any(flag == 1 for flag in private_flags):
+            return "Private organization"
+        if row.get("q10_org_class_PUBLIC_SECTOR_BODY", 0) == 1:
+            return "Public sector body"
+        return "Other / unknown"
+    return "Other / unknown"
+
