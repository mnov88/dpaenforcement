+def save_chart(fig: plt.Figure, filename: str) -> ChartArtifact:
+    path = OUTPUT_DIR / filename
+    fig.tight_layout()
+    fig.savefig(path, dpi=300)
+    plt.close(fig)
+    return ChartArtifact(filename=filename, title=filename.replace("_", " ").title(), description="")
+
+
+def encode_image(path: Path) -> str:
+    with path.open("rb") as f:
+        data = base64.b64encode(f.read()).decode("utf-8")
+    mime = "image/png"
+    return f"data:{mime};base64,{data}"
+
+
+def describe_series(series: pd.Series) -> str:
+    return ", ".join(
+        f"{idx}: {val:.1%}" for idx, val in series.sort_values(ascending=False).items()
+    )
+
+
+def build_time_trends(df: pd.DataFrame) -> ChartArtifact:
+    plot_df = (
+        df.dropna(subset=["decision_year"])
+        .groupby(["decision_year", "entity_type"])
+        .size()
+        .reset_index(name="cases")
+    )
+    fig, ax = plt.subplots(figsize=(10, 6))
+    sns.lineplot(data=plot_df, x="decision_year", y="cases", hue="entity_type", marker="o", ax=ax)
+    ax.set_title("Case volume over time by entity type")
+    ax.set_xlabel("Decision year")
+    ax.set_ylabel("Number of decisions")
+    ax.set_xticks(sorted(plot_df["decision_year"].unique()))
+    ax.legend(title="Entity type")
+    artifact = save_chart(fig, "time_trends.png")
+    artifact.description = (
+        "Annual counts show how enforcement attention to public sector bodies compares with other defendant types."
+    )
+    return artifact
+
+
+def build_initiation_chart(summary: pd.DataFrame) -> ChartArtifact:
+    top_options = (
+        summary.groupby("option")["count"].sum().sort_values(ascending=False).head(6).index.tolist()
+    )
+    plot_df = summary[summary["option"].isin(top_options)].copy()
+    plot_df["share_pct"] = plot_df["share"] * 100
+    fig, ax = plt.subplots(figsize=(10, 6))
+    sns.barplot(data=plot_df, x="option", y="share_pct", hue="entity_type", ax=ax)
+    ax.set_title("Investigation initiation pathways by entity type")
+    ax.set_xlabel("Initiation pathway (Q15)")
+    ax.set_ylabel("Share of decisions (%)")
+    ax.set_xticklabels(ax.get_xticklabels(), rotation=30, ha="right")
+    ax.legend(title="Entity type")
+    artifact = save_chart(fig, "initiation_comparison.png")
+    artifact.description = (
+        "Complaint-driven investigations dominate across the board, but public bodies face a higher mix of ex officio probes."
+    )
+    return artifact
+
+
+def build_violation_heatmap(summary: pd.DataFrame, title: str, filename: str) -> ChartArtifact:
+    pivot = summary.pivot(index="option", columns="entity_type", values="share").fillna(0)
+    pivot = pivot.loc[pivot.sum(axis=1).sort_values(ascending=False).index]
+    fig, ax = plt.subplots(figsize=(8, max(4, len(pivot) * 0.4)))
+    sns.heatmap(pivot * 100, annot=True, fmt=".1f", cmap="magma", cbar_kws={"label": "Share of decisions (%)"}, ax=ax)
+    ax.set_title(title)
+    ax.set_xlabel("Entity type")
+    ax.set_ylabel("Finding")
+    artifact = save_chart(fig, filename)
+    artifact.description = (
+        "Heatmap reveals which substantive GDPR principles most frequently appear in findings against each entity type."
+    )
+    return artifact
